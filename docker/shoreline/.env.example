# Match the boat, simulator, LiDAR publisher, and other PCs.
# Existing milliAmpere Compose does not set a domain: ROS defaults to 0.
# The old ZED setup used 42; set every participant to the same value.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Live sensors: false. Simulator or rosbag with /clock: true.
USE_SIM_TIME=false
PARAMS_FILE=/config/ma1-live.yaml

# Recorded mA1 data (latest global TF, approximate):
# PARAMS_FILE=/config/package/ma1.yaml
# Original mA2 configuration:
# PARAMS_FILE=/config/package/lidar_projection.yaml
